# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://vdetec:vdetec@localhost:5432/vdetec

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Storage (local ou S3)
STORAGE_BACKEND=local          # local | s3
MEDIA_ROOT=./media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Computer Vision
MODEL_PATH=./models/detector.pt
DETECTOR_CONF_THRESHOLD=0.45
DETECTOR_IOU_THRESHOLD=0.50
DEVICE=cuda                    # cuda | cpu | mps
BATCH_SIZE=8

# Cameras
CAMERA_POLL_INTERVAL_SEC=30
RTSP_TIMEOUT_SEC=10

# Alerts
ALERT_STOCKOUT_THRESHOLD=0     # unidades mínimas antes do alerta
ALERT_EMAIL_FROM=noreply@vdetec.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
CORS_ORIGINS=http://localhost:3000
