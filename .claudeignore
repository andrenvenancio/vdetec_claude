# Virtualenv
.venv/

# Models & weights (large binaries, not useful as context)
models/
*.pt
*.pth
*.onnx
*.weights

# Images & videos
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.tif
*.webp
*.heic
*.svg
*.ico
*.mp4
*.avi
*.mov
*.mkv

# Documentos binários (PDF/PPTX/DOCX são pesados e baixo sinal)
*.pdf
*.pptx
*.ppt
*.docx
*.doc
*.xlsx
*.xls
documentos/

# Pasta images/ inteira — só liberar subpasta específica abaixo se necessário
images/

# Resultados gerados (imagens anotadas)
results/

# Cache do vdetec (índices FAISS binários + meta)
.vdetec_cache/
.vdetec_cache_*/
**/.vdetec_cache/
**/.vdetec_cache_*/

# Media & uploads
media/
uploads/

# Logs
*.log
logs/

# Test & coverage artifacts
.coverage
htmlcov/
.pytest_cache/

# Cache
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# Docker volumes
postgres_data/
redis_data/

# Docs & notebooks (large, low-signal for code tasks)
docs/
*.ipynb

# Alembic migration SQL dumps
*.sql

# Compiled / dist
dist/
build/
